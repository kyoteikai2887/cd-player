{
  "name": "cd-player-v1",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:local": "node scripts/local.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:core": "node --test tests/core/*.test.ts",
    "test:ui": "vitest run",
    "native:prepare": "pnpm run build && node scripts/prepare-native.mjs",
    "native:build": "pnpm run native:prepare && tauri build --debug --no-bundle"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "music-metadata": "11.16.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "0.27.3",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "typescript": "~5.9.2",
    "vite": "^7.0.0",
    "vitest": "5.0.3"
  },
  "license": "MIT"
}
